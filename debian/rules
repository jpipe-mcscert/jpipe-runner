#!/usr/bin/make -f
# Build the Debian package from setup.py via pybuild.
#
# The project ships both a pyproject.toml (poetry-core backend) and a setup.py
# setuptools shim. `distutils` is pybuild's name for the setup.py-driven build
# (it invokes `setup.py`, which imports setuptools — not the removed stdlib
# distutils, so it works on Python 3.12+). Pinning it stops pybuild from
# auto-selecting the pyproject/poetry-core backend, whose availability varies by
# Ubuntu series.
export PYBUILD_SYSTEM=distutils

%:
	dh $@ --with python3 --buildsystem=pybuild

# The upstream test suite needs dev-only dependencies (pytest, poetry) that are
# not available on the Launchpad builders; tests run in CI instead.
override_dh_auto_test:
